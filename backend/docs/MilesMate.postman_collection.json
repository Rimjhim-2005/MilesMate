{
  "info": {
    "name": "MilesMate API",
    "description": "Run the folders in order (right-click the collection > Run). Signup saves the tokens automatically. Live location uses Socket.IO and is not covered here: see API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"status is ok\", function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth and profile (run these first, in order)",
      "item": [
        {
          "name": "Signup (user 1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set(\"email\", `driver${stamp}@example.com`);",
                  "pm.collectionVariables.set(\"email2\", `driver${stamp}b@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"returns a token and user\", function () { const j = pm.response.json(); pm.expect(j.token).to.be.a(\"string\"); pm.expect(j.user.name).to.eql(\"Test Driver\"); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ],
              "query": []
            },
            "description": "Creates user 1 and saves {{token}}. Also generates two unique emails for this run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Driver\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\",\n  \"vehicleInfo\": \"Swift Dzire\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (user 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"returns a token\", function () { pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login with wrong password (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"is user 1\", function () { pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Update my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"vehicle updated\", function () { pm.expect(pm.response.json().vehicleInfo).to.eql(\"Honda City\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Driver\",\n  \"vehicleInfo\": \"Honda City\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Signup (user 2, for ride and comment tests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"token2\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Second Driver\",\n  \"email\": \"{{email2}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Forum",
      "item": [
        {
          "name": "Create a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"has an id\", function () { pm.expect(pm.response.json().id).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"postId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forum",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 20.2961,\n  \"lng\": 85.8245,\n  \"body\": \"Deep pothole near the flyover exit, keep left.\",\n  \"category\": \"Road Hazard\",\n  \"severity\": \"High\",\n  \"title\": \"Pothole near flyover\",\n  \"locationLabel\": \"Flyover exit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a post with an invalid category (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forum",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 20.2961,\n  \"lng\": 85.8245,\n  \"body\": \"x\",\n  \"category\": \"Pothole\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Nearby posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"finds the new post\", function () { pm.expect(pm.response.json().some(function (p) { return p.id === pm.collectionVariables.get(\"postId\"); })).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/forum/nearby?lat=20.2961&lng=85.8245&radius=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "20.2961"
                },
                {
                  "key": "lng",
                  "value": "85.8245"
                },
                {
                  "key": "radius",
                  "value": "1000"
                }
              ]
            },
            "description": "radius is in metres (default 500). Nearest first, max 50.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Search by keyword",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"finds the new post, with coordinates\", function () { const p = pm.response.json().find(function (x) { return x.id === pm.collectionVariables.get(\"postId\"); }); pm.expect(p).to.exist; pm.expect(p.lat).to.be.a(\"number\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/forum/search?keyword=pothole",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "search"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "pothole"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Forum feed: top posts, one category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"is a list\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/forum/search?sort=top&category=Road%20Hazard&limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "search"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "top"
                },
                {
                  "key": "category",
                  "value": "Road%20Hazard"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "The Reddit-style forum home page: sort = new | top, optional category, limit (max 50) and offset for paging.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get one post with its comments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"has a comments array\", function () { pm.expect(pm.response.json().comments).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/forum/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "{{postId}}"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Add a comment (as user 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"author is user 2\", function () { pm.expect(pm.response.json().author).to.eql(\"Second Driver\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forum/{{postId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "{{postId}}",
                "comments"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Confirmed, I hit it this morning.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token2}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Upvote the post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"user_vote is 1\", function () { pm.expect(pm.response.json().user_vote).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forum/{{postId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "{{postId}}",
                "vote"
              ],
              "query": []
            },
            "description": "value: 1 = upvote, -1 = downvote, 0 = remove my vote. One vote per user per post.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remove my vote",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"user_vote is 0\", function () { pm.expect(pm.response.json().user_vote).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forum/{{postId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forum",
                "{{postId}}",
                "vote"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Trips",
      "item": [
        {
          "name": "Log a completed trip",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const end = new Date(); const start = new Date(end.getTime() - 25 * 60000);",
                  "pm.collectionVariables.set(\"startedAt\", start.toISOString());",
                  "pm.collectionVariables.set(\"endedAt\", end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"earnings start empty\", function () { pm.expect(pm.response.json().moneyEarned).to.eql(null); });",
                  "pm.collectionVariables.set(\"tripId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips"
              ],
              "query": []
            },
            "description": "moneyEarned is optional here; the driver can add it later with the PATCH request below.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startLat\": 20.2961,\n  \"startLng\": 85.8245,\n  \"endLat\": 20.35,\n  \"endLng\": 85.83,\n  \"startAddress\": \"Master Canteen\",\n  \"endAddress\": \"Patia\",\n  \"areaLabel\": \"Patia\",\n  \"distanceKm\": 8.4,\n  \"durationMinutes\": 25,\n  \"startedAt\": \"{{startedAt}}\",\n  \"endedAt\": \"{{endedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add money earned afterwards",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"earnings saved\", function () { pm.expect(pm.response.json().moneyEarned).to.eql(350); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}"
              ],
              "query": []
            },
            "description": "Send null to clear it again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moneyEarned\": 350\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List my trips",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"contains the trip\", function () { pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trips?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Dashboard",
      "item": [
        {
          "name": "30-day stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
